{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "python .cursor/hooks/memory-lookup.py",
        "matcher": "Read",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python .cursor/hooks/stop-probe.py",
        "timeout": 10
      }
    ]
  }
}
