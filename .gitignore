# Cline task history (local session data, not for sharing)
.cline_storage/

# Private configs (real hostnames, credentials, etc.) — skills/ is tracked
.cursor/configs/

# Explicitly track skills and rules (override any broad .cursor/ rules)
!.cursor/skills/
!.cursor/rules/

# Overnight task manager runtime outputs
overnight-results/
input-list.txt

# Hook runtime logs
.cursor/hooks/*.log

# Python
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp
*.swo

