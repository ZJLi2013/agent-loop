# Cline task history (local session data, not for sharing)
.cline_storage/

# Private configs (real hostnames, credentials, etc.) — skills/ is tracked
.cursor/configs/

# Explicitly track skills (override any broad .cursor/ rules)
!.cursor/skills/

# Project-level copies of what sync-to-cursor.ps1 already installs at user level:
# Cursor loads both layers, so keeping these here doubles every rule and hook in context.
.cursor/rules/
.cursor/hooks.json

# Overnight task manager runtime outputs
overnight-results/
input-list.txt

# Hook runtime logs
.cursor/hooks/*.log

# Per-project Harness runtime
.harness/

# Per-project agent runtime (templates live under skills/agent-memory/)
.cursor/task.md
.cursor/progress.md
.cursor/memory/

# Python
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp
*.swo

