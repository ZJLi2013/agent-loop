# Cline task history (local session data, not for sharing)
.cline_storage/

# Private configs (real hostnames, credentials, etc.)
configs/
.agent-loop/configs/
.cursor/configs/

# Project-level copies of what sync-to-cursor.ps1 already installs at user level:
# Cursor loads both layers, so keeping these here doubles every rule and hook in context.
.cursor/rules/
.cursor/hooks.json

# Overnight task manager runtime outputs
overnight-results/
input-list.txt

# Hook runtime logs
adapters/cursor/hooks/*.log
.cursor/hooks/*.log

# Per-project Harness runtime
.harness/

# Maintainer/project runtime (templates live under skills/agent-memory/)
.agent-loop/
agent-loop.code-workspace

# Legacy runtime read compatibility
.cursor/task.md
.cursor/progress.md
.cursor/memory/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pytest-cache-files-*/
.venv/
build/
dist/

# Other agents' scratch dirs and pager's default local state
.codex/
.pager/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp
*.swo

